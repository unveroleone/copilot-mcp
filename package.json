{
  "name": "copilot-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "MCP server that lets your coding agent (Claude Code, OpenCode, Codex and others) delegate prompts to the GitHub Copilot CLI for a second opinion. Named sessions keep their history across calls, Copilot runs read-only by default, and you can pick models or plug in your own provider.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unveroleone/copilot-mcp.git"
  },
  "homepage": "https://github.com/unveroleone/copilot-mcp#readme",
  "bugs": {
    "url": "https://github.com/unveroleone/copilot-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "opencode",
    "codex",
    "github-copilot",
    "copilot-cli",
    "code-review"
  ],
  "type": "module",
  "bin": {
    "copilot-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
